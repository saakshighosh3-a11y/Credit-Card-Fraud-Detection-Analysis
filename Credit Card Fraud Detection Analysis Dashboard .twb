      <aliases enabled='yes' />
      <column caption='Total Transactios' datatype='integer' name='[Calculation_0124777885884416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([is_fraud])' />
      </column>
      <column caption='Fraudulent Transactions' datatype='integer' name='[Calculation_0124777888153601]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_fraud])' />
      </column>
      <column caption='Fraud Rate' datatype='real' default-format='p0.00%' name='[Calculation_0124777888301058]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([is_fraud]) / COUNT([is_fraud])' />
      </column>
      <column caption='Legitimate Transactions' datatype='integer' name='[Calculation_0124777888800771]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([is_fraud]) - SUM([is_fraud])' />
      </column>
      <column caption='Transaction Hour' datatype='integer' name='[Calculation_0124777889570820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [trans_date_trans_time])' />
      </column>
      <column caption='Day of Week' datatype='string' name='[Calculation_0124777889730565]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;weekday&apos;, [trans_date_trans_time])' />
      </column>
      <column caption='Amount Ranges' datatype='string' name='[Calculation_0124777889955846]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [amt] &lt; 50 THEN &quot;0–50&quot;&#10;ELSEIF [amt] &lt; 100 THEN &quot;50–100&quot;&#10;ELSEIF [amt] &lt; 500 THEN &quot;100–500&quot;&#10;ELSEIF [amt] &lt; 1000 THEN &quot;500–1000&quot;&#10;ELSE &quot;1000+&quot;&#10;END' />
      </column>
